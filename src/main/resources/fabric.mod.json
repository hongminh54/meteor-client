{
  "schemaVersion": 1,
  "name": "Marisa Optimize",
  "id": "marisa-optimize",
  "version": "${version}",
  "description": "Mod tối ưu ram và xử lí thực thể",
  "authors": [
    "hongminh54"
  ],
  "license": "GPL-3.0",
  "icon": "assets/marisa-optimize/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.hongminh54.marisaoptimize.MarisaOptimize"
    ],
    "modmenu": [
      "com.hongminh54.marisaoptimize.modintegration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "marisa-optimize.json",
    "marisa-optimize-baritone.mixins.json",
    "marisa-optimize-indigo.mixins.json",
    "marisa-optimize-sodium.mixins.json",
    "marisa-optimize-lithium.mixins.json",
    "marisa-optimize-viafabricplus.mixins.json"
  ],
  "accessWidener": "marisa-optimize.accesswidener",
  "custom": {
    "marisa-optimize:build_number": "${build_number}",
    "marisa-optimize:color": "145,61,226",
    "marisa-optimize:commit": "${commit}",
    "modmenu": {
      "links": {
        "modmenu.discord": "https://www.facebook.com/tybzione/"
      }
    },
    "badoptimizations:cache_hooks": {
      "lightmap": "com.hongminh54.marisaoptimize.modintegration.BadOptimizationsHook"
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${minecraft_version}"],
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "sodium": "<0.8.7",
    "morechathistory": "*",
    "lithium": "<0.21.3"
  }
}
