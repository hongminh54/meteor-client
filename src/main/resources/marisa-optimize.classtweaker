classTweaker	v1	official

# Skin cache and firework particles
accessible   class   net/minecraft/client/resources/SkinManager$TextureCache
accessible   class   net/minecraft/client/particle/FireworkParticles$SparkParticle
# Client chunk cache, also used by Marisa's XrayMemory
accessible   class   net/minecraft/client/multiplayer/ClientChunkCache$Storage

accessible   field   net/minecraft/client/resources/MapTextureManager$MapInstance texture Lnet/minecraft/client/renderer/texture/DynamicTexture;
accessible   class   net/minecraft/client/gui/screens/inventory/BeaconScreen$BeaconPowerButton
accessible   class   net/minecraft/client/gui/screens/inventory/BeaconScreen$BeaconConfirmButton
accessible   class   net/minecraft/client/gui/screens/inventory/BeaconScreen$BeaconCancelButton
accessible   class   net/minecraft/client/ResourceLoadStateTracker$ReloadState

accessible   method  com/mojang/blaze3d/pipeline/RenderPipeline$Builder <init> ()V
